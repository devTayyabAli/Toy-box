# Server
PORT=9000
NODE_ENV=development
# Public API URL version segment (default v1 → /api/v1/...)
API_VERSION=v1

# Logging — set DISABLE_LOGS=true to silence app logs
# SEQUELIZE_LOG_QUERIES=true in production to log SQL at debug level
SEQUELIZE_LOG_QUERIES=false

# Rate limits (optional overrides)
# In development, auth rate limit and RateLimit-* response headers are OFF by default.
# Set RATE_LIMIT_AUTH_ENFORCE=true to enable auth throttling locally.
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_DISABLED=true
# RATE_LIMIT_DISABLED=true
# RATE_LIMIT_STANDARD_HEADERS=false
# RATE_LIMIT_API_MAX=1000
# RATE_LIMIT_PUBLIC_MAX=30

# Database pool & performance
# DB_POOL_MAX=20
# DB_POOL_MIN=5
# DB_SSL=false
# SEQUELIZE_SLOW_QUERY_MS=1000

# Timeouts (ms)
# REQUEST_TIMEOUT_MS=30000
# RESPONSE_TIMEOUT_MS=35000
# SERVER_TIMEOUT_MS=60000
# SHUTDOWN_FORCE_MS=30000

# TLS (optional — usually terminated at load balancer)
# TLS_KEY_PATH=
# TLS_CERT_PATH=
# REQUIRE_TLS=false

# HTTP logging
# HTTP_LOG_REQUESTS=true
# Ngrok URL — must match your ACTIVE tunnel (run: ngrok http 9000)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=toybox
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=change-me
REFRESH_SECRET=change-me-refresh

# Overdue service threshold (days since lastServicedAt)
SERVICE_OVERDUE_DAYS=365

# Brevo OTP emails — https://app.brevo.com → SMTP & API
# Use SMTP key (xsmtpsib-...) as SMTP_PASS, NOT the xkeysib API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=mnaveed@astraprotocol.com

SMTP_PASS=xsmtpsib-your-smtp-key
SMTP_FROM_NAME=Toy-Box
# Must be a verified sender in Brevo (Senders & Domains)
SMTP_FROM_EMAIL=your-verified-sender@yourdomain.com

# Optional: Brevo HTTP API (often easier than SMTP + IP whitelist)
# BREVO_API_KEY=xkeysib-your-api-key

# Brevo → SMTP & API → Authorized IPs — add your public IP or disable restriction for dev
# If you see "525 5.7.1 Unauthorized IP address", whitelist IP or use BREVO_API_KEY instead
OTP_LOG_CODE=true

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase — client SDK (web / React Native / Flutter via REST config endpoint)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Web push VAPID key (Firebase Console → Cloud Messaging → Web configuration)
# FIREBASE_VAPID_KEY=

# Firebase Admin — server push + Firestore chat (download JSON → secrets/firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Or inline credentials:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Dev only: in-memory chat when Admin SDK is missing (default on in development)
# CHAT_DEV_FALLBACK=true

# iOS — upload APNs .p8 in Firebase Console → Cloud Messaging, then set bundle ID
APNS_BUNDLE_ID=com.yourcompany.toybox

# Firestore chat collections (defaults shown)
# FIRESTORE_CONVERSATIONS_COLLECTION=conversations
# FIRESTORE_MESSAGES_SUBCOLLECTION=messages
# CONCIERGE_NAME=James T.
